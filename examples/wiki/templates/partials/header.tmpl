<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[% title %] &ndash; Wiki</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            display: flex;
            min-height: 100vh;
            color: #333;
        }
        .sidebar {
            width: 220px;
            border-right: 1px solid #ddd;
            padding: 1.5rem 1rem;
            background: #fafafa;
            font-size: 0.9rem;
            flex-shrink: 0;
        }
        .sidebar h2 { font-size: 1rem; margin-bottom: 1rem; }
        .sidebar ul { list-style: none; }
        .sidebar li { margin: 0.4rem 0; }
        .sidebar a { color: #333; text-decoration: none; }
        .sidebar a:hover { text-decoration: underline; }
        .content {
            flex: 1;
            padding: 2rem;
            max-width: 720px;
            line-height: 1.7;
        }
        .content h1 { margin-bottom: 1rem; }
        a { color: #0066cc; }
    </style>
</head>
<body>
<nav class="sidebar">
    <h2><a href="/" style="color: #000">Wiki</a></h2>
    <ul>
    [% FOREACH c = collections.pages.sort %]
        <li><a href="pages/[% c %]">[% c.replace('(-|_|\.html)', ' ') %]</a></li>
    [% END %]
    </ul>
</nav>
<main class="content">
