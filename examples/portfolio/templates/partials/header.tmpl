<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[% title %]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            color: #222;
            line-height: 1.6;
            max-width: 900px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }
        a { color: #0066cc; text-decoration: none; }
        a:hover { text-decoration: underline; }
        header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2rem; border-bottom: 2px solid #222; padding-bottom: 1rem; }
        header h1 { font-size: 1.3rem; }
        header nav a { margin-left: 1.5rem; font-size: 0.95rem; color: #222; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem; }
        .card { border: 1px solid #ddd; padding: 1.2rem; }
        .card h3 { margin-bottom: 0.5rem; }
        .card p { font-size: 0.9rem; color: #555; }
    </style>
</head>
