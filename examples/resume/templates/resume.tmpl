<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[% title %]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #333;
            max-width: 700px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
            line-height: 1.6;
        }
        h1 { font-size: 1.8rem; margin-bottom: 0.3rem; }
        h2 { font-size: 1.1rem; color: #555; margin-top: 2rem; margin-bottom: 0.6rem; border-bottom: 1px solid #ddd; padding-bottom: 0.3rem; }
        h3 { font-size: 0.95rem; margin-top: 1rem; }
        p, li { font-size: 0.9rem; }
        ul { padding-left: 1.2rem; }
        a { color: #0066cc; text-decoration: none; }
        .contact { font-size: 0.9rem; color: #666; margin-bottom: 1.5rem; }
        .contact a { margin-right: 1rem; }
    </style>
</head>
<body>

<h1>[% title %]</h1>
<div class="contact">
    [% FOREACH part IN body %]
        [% part %]
    [% END %]
</div>

</body>
</html>
