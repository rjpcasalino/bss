<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>[% title %]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Georgia, serif;
            color: #222;
            background: #fff;
            max-width: 960px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        a { color: #222; }
        header { text-align: center; margin-bottom: 2rem; }
        header h1 { font-size: 1.5rem; letter-spacing: 0.05em; text-transform: uppercase; }
        header nav { margin-top: 0.5rem; }
        header nav a { margin: 0 0.8rem; text-decoration: none; font-size: 0.9rem; }
        header nav a:hover { text-decoration: underline; }
        .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
        .photo-grid a { display: block; }
        .photo-grid a:hover { opacity: 0.85; }
    </style>
</head>
<body>
<header>
    <h1>[% title %]</h1>
    <nav>
        <a href="/">Gallery</a>
        <a href="/about.html">About</a>
    </nav>
</header>
